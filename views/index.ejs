<%- include("partials/header.ejs") %>

<div class="px-4 py-5 my-5 text-center">
    <img class="d-block mx-auto mb-4" src="/images/blog-photo.png" alt="" width="100" height="75">
    <h1 class="display-5 fw-bold text-body-emphasis">Welcome to Parke's Blog 😎</h1>
<div class="col-lg-6 mx-auto">
    <p class="lead mb-4">Quickly post, edit, and delete a blog pertaining to whatever is on your mind! Please be respectful of others when posting and responding to content.</p>

<div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
    <form action="/create-and-view" method="POST">
    <label for="title">Post Title:</label>
    <input type="text" name="title" style="width: 500px;" required><br><br>
    <label for="body" style="vertical-align: top;">Post Body:</label>
    <textarea name="body" style="width: 500px; height: 200px;" required></textarea><br>
    <input type="submit" class="btn btn-success" value="Submit" style="display: block; margin: 10px 0 0 300px;">
    </form>

</div>
</div>

<div class="container px-4 py-5" id="hanging-icons">
  <h2 class="pb-2 border-bottom">View Posts Below</h2>
  
  <div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
    <% if (locals.posts_and_titles) { %>
        <% for( const [key, value] of posts_and_titles ) { %>
            <div class="col d-flex align-items-start">
                <div>
                    <h3 class="fs-2 text-body-emphasis"><%= key %></h3>
                    <p><%= value %></p>
                    
                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-center gap-2 mt-3">
                        <form action="/edit-post" method="POST">
                            <input type="hidden" name="edit" value="<%= key %>">
                            <button type="submit" class="btn btn-primary btn-sm">Edit</button>
                        </form>

                        <form action="/delete-post" method="POST">
                            <input type="hidden" name="delete" value="<%= key %>">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>
    <% } %>
  </div> <!-- This closes the .row -->
</div> <!-- This closes the .container -->

</div>
</div>

</div>
</div>

<%- include("partials/footer.ejs") %>
